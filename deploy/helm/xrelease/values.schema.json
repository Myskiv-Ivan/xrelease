{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "xrelease Helm values",
  "description": "Type gate for the values an operator is most likely to get wrong. Product rules that need cross-field logic (replicaCount, secrets either/or, CHANGE_ME placeholders) are enforced by xrelease.validate in _helpers.tpl, which fails with an actionable message.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Must be 1 — one poller per PostgreSQL database. Not capped here on purpose: xrelease.validate rejects >1 with an actionable message pointing at docs/operations/scaling.md."
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Only the first element is used as the subcommand."
    },
    "config": {
      "type": "object",
      "properties": {
        "existingConfigMap": {
          "type": "string",
          "description": "Must carry the keys bootstrap.toml and releases.yaml."
        },
        "bootstrapInline": { "type": "string" },
        "appInline": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "properties": { "url": { "type": "string" } }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "$ref": "#/definitions/ingressHosts" },
        "tls": { "$ref": "#/definitions/ingressTLS" },
        "api": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "type": "object" },
            "hosts": { "$ref": "#/definitions/ingressHosts" },
            "tls": { "$ref": "#/definitions/ingressTLS" }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRef": { "$ref": "#/definitions/parentRef" },
        "hostnames": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" },
        "filters": { "type": "array" },
        "timeouts": {
          "type": "object",
          "properties": {
            "request": { "type": "string" },
            "backendRequest": { "type": "string" }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "parentRef": { "$ref": "#/definitions/parentRef" },
            "hostnames": { "type": "array", "items": { "type": "string" } },
            "paths": {
              "type": "array",
              "items": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["builtin", "cnpg", "external"],
          "description": "builtin = chart StatefulSet, cnpg = CloudNativePG Cluster, external = managed service."
        },
        "cnpg": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "clusterName": {
              "type": "string",
              "description": "Not length-checked here on purpose: xrelease.validate rejects an empty name with an actionable message."
            },
            "namespace": { "type": "string" },
            "instances": { "type": "integer", "minimum": 1 },
            "imageName": { "type": "string" },
            "database": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 },
            "sslMode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] },
            "storage": {
              "type": "object",
              "properties": {
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            },
            "walStorage": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            },
            "resources": { "$ref": "#/definitions/resources" },
            "postgresql": { "type": "object" },
            "affinity": { "type": "object" },
            "monitoring": { "type": "object" },
            "backup": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "destinationPath": { "type": "string" },
                "endpointURL": { "type": "string" },
                "retentionPolicy": { "type": "string" },
                "credentialsSecret": { "type": "string" }
              }
            }
          }
        },
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string" },
        "auth": {
          "type": "object",
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "database": { "type": "string", "minLength": 1 }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|k|Ei|Pi|Ti|Gi|Mi|Ki)?$" },
            "storageClass": { "type": "string" },
            "retain": { "type": "boolean" }
          }
        },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "apprise": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "workerCount": { "type": ["integer", "string"], "description": "Gunicorn workers; keep 1 under typical memory limits." },
        "statefulMode": { "type": "string" },
        "service": {
          "type": "object",
          "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Stateless nginx — safe above 1, unlike the backend. >1 also renders a PodDisruptionBudget and a soft anti-affinity spread."
        },
        "exposeMetrics": {
          "type": "boolean",
          "description": "Publishes the unauthenticated /metrics through the public Ingress."
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "enum": ["", "Always", "IfNotPresent", "Never"] }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "env": {
          "type": "object",
          "properties": {
            "VITE_AUTH_MODE": { "enum": ["local", "oidc"] },
            "VITE_API_URL": { "type": "string" },
            "VITE_API_KEY_DEFAULT_ROLE": { "enum": ["admin", "operator", "viewer"] }
          },
          "additionalProperties": { "type": "string" }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "apiKey": { "type": "string" },
        "databaseUrl": { "type": "string" },
        "webhookSecret": { "type": "string" },
        "expressAccessToken": { "type": "string" },
        "configEncryptionKey": { "type": "string" },
        "sessionSecret": { "type": "string" },
        "adminUser": { "type": "string" },
        "adminPassword": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": { "automountServiceAccountToken": { "type": "boolean" } }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressControllerNamespace": { "type": "string", "minLength": 1 },
        "monitoringNamespace": {
          "type": "string",
          "description": "Namespace Prometheus scrapes from. Empty drops the rule — the policy never allows an unscoped source."
        },
        "blockPrivateEgress": { "type": "boolean" },
        "extraEgressCIDRs": {
          "type": "array",
          "description": "CIDRs, not hostnames — NetworkPolicy has no DNS. IPv4 or IPv6.",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$" }
        }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" }
  },
  "definitions": {
    "parentRef": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "sectionName": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "port": { "type": ["integer", "string"] }
      }
    },
    "ingressHosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
              },
              "required": ["path", "pathType"]
            }
          }
        },
        "required": ["host", "paths"]
      }
    },
    "ingressTLS": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "secretName": { "type": "string", "minLength": 1 },
          "hosts": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["secretName", "hosts"]
      }
    }
  }
}
