{
	"name": "front",
	"private": true,
	"version": "0.2.6",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:api": "npx -y openapi-typescript@7.13.0 ../api/openapi.json -o src/lib/api/schema.d.ts",
		"check:api": "node scripts/check-api-schema.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource/fira-sans": "^5.3.0",
		"@lucide/svelte": "^1.66.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.7.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@scalar/api-reference": "^1.76.4",
		"smol-toml": "^1.9.1",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"undici": ">=7.30.1",
		"runed": "^0.38.0",
		"deepmerge": "npm:@stackline/deepmerge@^1.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
