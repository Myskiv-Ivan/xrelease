{
	"name": "front",
	"private": true,
	"version": "0.2.4",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:api": "npx -y openapi-typescript@7.13.0 ../api/openapi.json -o src/lib/api/schema.d.ts",
		"check:api": "node scripts/check-api-schema.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource/fira-sans": "^5.3.0",
		"@lucide/svelte": "^1.53.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@scalar/api-reference": "^1.73.1",
		"smol-toml": "^1.9.0",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
