{
	"name": "front",
	"private": true,
	"version": "0.1.1",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gen:api": "npx -y openapi-typescript@7.13.0 ../api/openapi.json -o src/lib/api/schema.d.ts",
		"check:api": "node scripts/check-api-schema.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.27.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@scalar/api-reference": "^1.63.0",
		"smol-toml": "^1.7.1",
		"yaml": "^2.9.0"
	}
}
