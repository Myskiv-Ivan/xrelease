# xrelease — single env template (backend + UI + OIDC + secrets).
# Docker / local:  cp .env.example .env
#                  then fill the blank secrets below (see openssl examples)
# K8s:             map the same keys into a Secret (deploy/k8s/secret.example.yaml)
# Front (Vite):    reads this file from the repo root (front/vite.config.ts envDir)
#
# NEVER commit .env or real secret values to Git.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# POSTGRES_* configure the bundled Compose `postgres` service; keep in sync with
# the URL. In K8s / managed Postgres only XRELEASE_DATABASE_URL matters.
POSTGRES_USER=xrelease
POSTGRES_PASSWORD=xrelease
POSTGRES_DB=xrelease
XRELEASE_DATABASE_URL=postgres://xrelease:xrelease@postgres:5432/xrelease
# TLS for managed Postgres (ignored when unset — Compose uses plain TCP):
# XRELEASE_DATABASE_SSL_MODE=require
# XRELEASE_DATABASE_SSL_MODE=verify-full
# XRELEASE_DATABASE_SSL_ROOT_CERT=/certs/rds-ca.pem
# Or embed in the URL: .../xrelease?sslmode=require

# ── Management API + inbound forge webhooks ─────────────────────────────────
# Required for serve (api.require_auth defaults to true). Fill each blank, e.g.:
#   openssl rand -hex 24          → XRELEASE_API_KEY / WEBHOOK_SECRET / ADMIN_PASSWORD
#   openssl rand -hex 32          → XRELEASE_SESSION_SECRET
#   openssl rand -base64 32       → XRELEASE_CONFIG_ENCRYPTION_KEY
XRELEASE_API_KEY=
# Shared secret for POST /api/v1/webhooks/* (GitHub HMAC, GitLab token, generic, …).
# Configure the same value in the forge’s webhook settings. Requires `xrelease serve`.
XRELEASE_WEBHOOK_SECRET=
# Optional: separate secret for outbound [[notifiers]] type=webhook HMAC signing
# (set notifier secret_env = "XRELEASE_OUTBOUND_WEBHOOK_SECRET" in YAML/UI):
# XRELEASE_OUTBOUND_WEBHOOK_SECRET=
# HMAC for POST /api/v1/config/apply when [config_api] is enabled:
# XRELEASE_CONFIG_APPLY_SECRET=
# AES-256-GCM key for app_secret values (required when source = "api").
XRELEASE_CONFIG_ENCRYPTION_KEY=
# Lab-only: store app_secret values as plaintext (do not use in production):
# XRELEASE_ALLOW_PLAINTEXT_CONFIG_LEDGER=1

# ── Local UI auth (default login) ───────────────────────────────────────────
# Local login needs a DEDICATED session secret (never derived from the API key,
# which is a shared automation credential). Without XRELEASE_SESSION_SECRET,
# local login is disabled and no admin is seeded — fail closed, not `admin`/`admin`.
# The admin is seeded into Postgres on first boot only when BOTH the session
# secret AND XRELEASE_ADMIN_PASSWORD are set.
XRELEASE_SESSION_SECRET=
XRELEASE_ADMIN_USER=admin
XRELEASE_ADMIN_PASSWORD=
# XRELEASE_SESSION_TTL_SECS=86400
# XRELEASE_LOCAL_AUTH=true

XRELEASE_LOG=info
# XRELEASE_API_LISTEN=0.0.0.0:8080

# ── UI (Vite / runtime) ─────────────────────────────────────────────────────
# Applied at container start via /ui-config.js (no image rebuild for GHCR pulls).
# Compose passes these into the `ui` service; Helm: values.ui.env.
# Auth mode: local (default) | api_key | oidc | hybrid
VITE_AUTH_MODE=local
# Empty = same-origin behind UI nginx (Compose/Helm default — correct).
# Only set for local Vite against a bare API on the host:
# VITE_API_URL=http://127.0.0.1:8080
# Do NOT set VITE_API_URL to :8080 with Docker Compose — that port is not published.
VITE_API_KEY_DEFAULT_ROLE=admin
# VITE_GRAFANA_EMBED_URL=https://grafana.example.com/d-solo/xrelease/xrelease?orgId=1&panelId=1
# OIDC behind HTTPS — absolute redirect after enabling edge TLS below:
# VITE_OIDC_REDIRECT_URI=https://xrelease.example.com/login/callback

# ── Edge HTTPS (optional — docker/compose.tls.yaml) ─────────────────────────
# TLS terminates on the UI nginx container (same image as HTTP).
#   docker compose -f docker-compose.yaml -f docker/compose.tls.yaml up -d
# Docs: docs/operations/tls.md · docker/certs/README.md
#
# XRELEASE_PUBLIC_HOST=xrelease.example.com
# XRELEASE_TLS_HTTP_PORT=80
# XRELEASE_TLS_HTTPS_PORT=443
# Certificate + private key (host paths; defaults under docker/certs/):
# XRELEASE_TLS_CERT=./docker/certs/cert.pem
# XRELEASE_TLS_KEY=./docker/certs/key.pem

# ── OIDC (backend JWT + UI SSO) ─────────────────────────────────────────────
# Point at your IdP (Keycloak / Authentik / Okta / Entra ID / …).
# Full recipes: docs/operations/oidc.md — no in-compose IdP.
# Set VITE_* + XRELEASE_OIDC_* then restart backend + UI (no image rebuild).
#
# Backend — JWT `iss` must match the browser-facing issuer URL.
# XRELEASE_OIDC_ISSUER=https://auth.example.com/realms/xrelease
# When discovery host differs from iss (internal DNS / mesh):
# XRELEASE_OIDC_DISCOVERY_URL=https://keycloak.internal/realms/xrelease
# XRELEASE_OIDC_JWKS_URI=https://auth.example.com/realms/xrelease/protocol/openid-connect/certs
# XRELEASE_OIDC_AUDIENCE=xrelease-ui
# Optional authorization gate (scope/scp claim):
# XRELEASE_OIDC_REQUIRED_SCOPE=xrelease:manage
# Server-side role mapping (used on POST /api/v1/auth/oidc/sync):
# XRELEASE_OIDC_ROLE_CLAIM=groups
# XRELEASE_OIDC_ROLE_ADMIN=xrelease-admin,admin
# XRELEASE_OIDC_ROLE_OPERATOR=xrelease-operator,operator
# XRELEASE_OIDC_ROLE_VIEWER=xrelease-viewer,viewer
# XRELEASE_OIDC_DEFAULT_ROLE=viewer
#
# UI — keep issuer/client in sync with XRELEASE_OIDC_* above.
# VITE_AUTH_MODE=oidc
# VITE_OIDC_ISSUER=https://auth.example.com/realms/xrelease
# VITE_OIDC_CLIENT_ID=xrelease-ui
# Defaults to {origin}/login/callback when unset:
# VITE_OIDC_REDIRECT_URI=https://xrelease.example.com/login/callback
# VITE_OIDC_SCOPES=openid,profile,email,groups
# Keycloak realm roles often: realm_access.roles
# VITE_OIDC_ROLE_CLAIM=groups
# VITE_OIDC_ROLE_ADMIN=xrelease-admin,admin
# VITE_OIDC_ROLE_OPERATOR=xrelease-operator,operator
# VITE_OIDC_ROLE_VIEWER=xrelease-viewer,viewer

# ── Notifier secrets (eXpress / SMTP / Novu / Slack / Telegram / RabbitMQ) ──
# BotX Bearer for POST /api/v4/botx/notifications/direct (no GET /token).
# Single sink: leave access_token empty in YAML and set:
# XRELEASE_EXPRESS_ACCESS_TOKEN=
# Per-team sinks (YAML access_token_env → these names; multi-team example):
# XRELEASE_EXPRESS_TOKEN_PLATFORM=
# XRELEASE_EXPRESS_TOKEN_SECURITY=
# SMTP AUTH when notifier password is empty (password_env or global):
# XRELEASE_SMTP_PASSWORD=
# Novu secret API key (leave api_key empty in YAML when using api_key_env):
# XRELEASE_NOVU_API_KEY=
# Slack Incoming Webhook URL (or use webhook_url_env per sink):
# XRELEASE_SLACK_WEBHOOK_URL=
# Slack Bot token for chat.postMessage (or bot_token_env per sink):
# XRELEASE_SLACK_BOT_TOKEN=
# Telegram BotFather token (or bot_token_env per sink):
# XRELEASE_TELEGRAM_BOT_TOKEN=
# RabbitMQ AMQP URL when url is empty (or url_env per sink):
# XRELEASE_RABBITMQ_URL=
# NATS URL when url is empty (or url_env per sink):
# XRELEASE_NATS_URL=

# ── Upstream forge tokens (optional) ───────────────────────────────────────
# Leave unset — an empty GITHUB_TOKEN= makes GitHub API calls fail with 401.
# GITHUB_TOKEN=ghp_...
# GITLAB_TOKEN=
# CODEBERG_TOKEN=
# GITEA_TOKEN=
# BITBUCKET_TOKEN=
# GHCR_TOKEN=
# QUAY_TOKEN=

# ── Delivery notes ──────────────────────────────────────────────────────────
# Apprise urls / config_key and Novu workflow / topic live in the desired
# document (YAML or UI Delivery channels → Apply) — not in env overlays.
# Compose injects XRELEASE_APPRISE_ENDPOINT=http://apprise:8000 for the sidecar.
# Docs: docs/configuration/apprise.md (Apprise, Novu, Slack, Telegram, SMTP, …)
# Example Apprise schemes for YAML/UI:
#   Telegram: tgram://<bot-token>/<chat-id>
#   Discord:  discord://<webhook-id>/<webhook-token>
#   Email:    mailto://user:APP_PASSWORD@google.com?to=user@google.com
#
# Inbound forge webhooks (into xrelease): see docs/api/webhooks.md
#   GitHub → POST /api/v1/webhooks/github  (secret = XRELEASE_WEBHOOK_SECRET)
# Outbound HTTP webhooks (from xrelease): Config → Edit → Add channel → Webhook
#   or notifiers: [{ type: webhook, … }] in the desired document (headers, secret_env, …)
